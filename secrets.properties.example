# secrets.properties olarak kopyala ve doldur. Bu dosya ve .pem anahtarı repoya girmez.
# Enable Banking Control Panel > Applications: production uygulamanın kimliği (UUID)
ENABLE_BANKING_APP_ID=
# Uygulamayı oluştururken indirilen özel anahtar (repo köküne göre yol)
ENABLE_BANKING_KEY_FILE=secrets/enablebanking.pem
# Uygulamada kayıtlı yönlendirme adresi; açılmaz, launcher onu yakalar
ENABLE_BANKING_REDIRECT_URL=https://localhost/callback
# Ana ekranda gösterilecek bankalar (Enable Banking'deki adlarıyla, virgülle, bu sırayla)
ENABLE_BANKING_ASPSPS=N26,Revolut,Wise
ENABLE_BANKING_COUNTRY=DE
